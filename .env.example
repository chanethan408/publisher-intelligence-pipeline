# =====================================================================
# Pipeline Credentials & Configuration Template (.env.example)
# Duplicate this file to .env and populate with real values.
# NEVER commit the active .env file to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Ingestion: YouTube Data API v3
# ---------------------------------------------------------------------
YOUTUBE_API_KEY="AIzaSyYourYouTubeDataApiKeyHere"

# ---------------------------------------------------------------------
# 2. Cloud Storage: AWS S3
# ---------------------------------------------------------------------
AWS_ACCESS_KEY_ID="AKIAYourAWSAccessKeyId"
AWS_SECRET_ACCESS_KEY="YourAWSSecretAccessKey"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="publisher-intelligence-raw-prod"

# ---------------------------------------------------------------------
# 3. Data Warehouse: Snowflake & dbt Connection
# ---------------------------------------------------------------------
SNOWFLAKE_ACCOUNT="xy12345.us-east-1"
SNOWFLAKE_USER="PUBLISHER_LOADER"
SNOWFLAKE_PASSWORD="YourSecureSnowflakePassword"
SNOWFLAKE_ROLE="ACCOUNTADMIN"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
SNOWFLAKE_DATABASE="PUBLISHER_DWH"
SNOWFLAKE_SCHEMA="RAW_INGEST"

# ---------------------------------------------------------------------
# 4. Orchestration: Apache Airflow (Dockerized / Local)
# ---------------------------------------------------------------------
AIRFLOW_UID=50000
_PIP_ADDITIONAL_REQUIREMENTS=""